# Copy this file to .env and adjust values for your environment.

# ── Application ────────────────────────────────────────────────
NODE_ENV=development

# ── MLB Stats API ───────────────────────────────────────────────
# Override only if proxying or using a local mirror
MLB_API_BASE=https://statsapi.mlb.com/api

# ── MySQL / TypeORM ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nonrootuser
DB_PASSWORD=mysql-root-pass
DB_NAME=baseball
# Set to 'true' to enable TypeORM query logging
TYPEORM_LOGGING=false

# ── Redis ───────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# ── BullMQ worker concurrency (hardcoded in processor decorators) ─
# game-poller concurrency: 5  (poller/poller.processor.ts)
# daily-poller concurrency: 2  (poller/daily-poller.processor.ts)
