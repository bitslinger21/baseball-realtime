{
  "name": "baseball-realtime",
  "version": "1.0.35",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "corepack enable",
    "build": "nest build",
    "typeorm": "typeorm-ts-node-commonjs",
    "redis:clean": "yarn redis:down && rm -rf ~/docker/${SERVICE_NAME}/mysql/data",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down redis",
    "db:clean": " yarn db:down && rm -rf ~/docker/baseball/mysql/data",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down mysql",
    "migration:gen": "yarn typeorm migration:generate src/migrations/init_schema -d ./src/config/typeorm.config.cli.ts",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d src/config/typeorm.config.cli.ts",
    "migration:revert": "yarn typeorm migration:revert -d ./src/config/typeorm.config.cli.ts",
    "migration:create": "cross-env NODE_PATH=./ yarn typeorm migration:create ./src/migrations/cre",
    "spec:gen": "cross-env SPEC_GEN=1 DB_ENGINE=sqlite NODE_PATH=./ ts-node ./scripts/writeSpec.ts",
    "spec:check": "cross-env SPEC_GEN=1 DB_ENGINE=sqlite NODE_PATH=./ ts-node ./scripts/checkSpec.ts",
    "client:clean": "rm -rf generated/client/typescript-axios/dist",
    "client:build": "cross-env SPEC_GEN=1 yarn spec:gen && yarn client:clean && just generate-client && node ./scripts/syncClientVersion.js",
    "client:publish": "cross-env SPEC_GEN=1 yarn spec:gen && yarn client:clean && just generate-client && node ./scripts/syncClientVersion.js && cd generated/client/typescript-axios && yarn npm publish --access public",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "mysql": "mysql -h 127.0.0.1 -u nonrootuser -pmysql-root-pass -P 3306 baseball"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@bitslinger21/baseball-realtime-client": "1.0.12",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "11",
    "@nestjs/websockets": "^11.1.6",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "bullmq": "^5.60.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.0",
    "mlb-stats-api": "^2.0.0",
    "mysql2": "^3.15.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "0.3",
    "undici": "^7.16.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "yarn@4.10.3"
}
